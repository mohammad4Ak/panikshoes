# دیتابیس PostgreSQL (لوکال: داکر | پروداکشن: Neon/Supabase)
# نمونه Neon: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/shoes_shop?schema=public"

# کلید NextAuth (یک رشته تصادفی طولانی)
AUTH_SECRET="replace-with-a-long-random-secret"

# ثبت‌نام با کد یک‌بارمصرف. روش‌ها پس از تنظیم کلید در پنل مدیریت فعال می‌شوند.
# REGISTRATION_EMAIL_API_KEY=""
# REGISTRATION_KAVENEGAR_API_KEY=""
# کلید تصادفی مستقل با حداقل ۳۲ نویسه؛ در صورت خالی بودن از AUTH_SECRET استفاده می‌شود.
# REGISTRATION_OTP_SECRET=""

# درگاه زرینپال
ZARINPAL_MERCHANT_ID="your-merchant-id"

# برای زمان‌بند آزادسازی رزرو در محیط serverless؛ حداقل ۳۲ نویسهٔ تصادفی
# CRON_SECRET=""

# فقط روی Vercel (بعد از فعالسازی Blob Store خودکار داده میشود)
# BLOB_READ_WRITE_TOKEN=""
