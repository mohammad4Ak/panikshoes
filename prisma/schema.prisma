// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  loginPhone String?  @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  name      String
  password  String
  role      Role      @default(USER)
  phone     String?
  postalCode String?
  isActive Boolean @default(true)
  authVersion Int @default(0)
  orders    Order[]
  addresses Address[]
  reviews   ProductReview[]
  couponRedemptions CouponRedemption[]
  stockMovements StockMovement[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RegistrationSettings {
  id                     Int      @id @default(1)
  emailEnabled           Boolean  @default(false)
  smsEnabled             Boolean  @default(false)
  expiryMinutes          Int      @default(5)
  maxAttempts            Int      @default(5)
  resendSeconds          Int      @default(60)
  destinationHourlyLimit Int      @default(5)
  ipHourlyLimit          Int      @default(30)
  emailSender            String   @default("auth")
  smsTemplate            String   @default("")
  smsProvider            String   @default("kavenegar")
  smsApiUrl              String   @default("")
  smsMethod              String   @default("POST")
  smsBodyFormat          String   @default("json")
  smsBodyTemplate        String   @default("{\"mobile\":\"{{phone}}\",\"code\":\"{{code}}\"}")
  smsHeadersEncrypted    String?
  smsApiKeyEncrypted     String?
  smsSuccessPath         String   @default("")
  smsSuccessValue        String   @default("200")
  version                Int      @default(0)
  updatedAt              DateTime @updatedAt
}

model RegistrationChallenge {
  id          String    @id @default(cuid())
  channel     String
  destination String
  codeDigest  String
  attempts    Int       @default(0)
  expiresAt   DateTime
  resendAt    DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([channel, destination])
  @@index([expiresAt])
}

model RegistrationRateLimit {
  key             String   @id
  windowStartedAt DateTime
  count           Int

  @@index([windowStartedAt])
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String?
  address   String
  phone     String
  postalCode String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  // Administrators enter this code; the fallback keeps internal imports compatible.
  // The migration also enforces case-insensitive uniqueness at the database level.
  code        String      @unique @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Int
  salePrice   Int?
  saleStartsAt DateTime?
  saleEndsAt  DateTime?
  images      String[]
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  type        ShoeType?
  sizes       Int[]
  colors      String[]
  stock       Int         @default(0)
  inventoryConfigured Boolean @default(false)
  inventoryVersion Int @default(0)
  variants    ProductVariant[]
  stockMovements StockMovement[]
  featured    Boolean     @default(false)
  specifications Json    @default("[]")
  viewCount   Int         @default(0)
  reviews     ProductReview[]
  pageViews   PageView[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProductVariant {
  id        String @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  size      Int
  color     String
  stock     Int @default(0)
  damagedStock Int @default(0)
  lowStockThreshold Int @default(2)
  isActive  Boolean @default(true)
  orderItems OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, size, color])
  @@index([productId, isActive])
}

// Immutable movement snapshots survive order deletion and retain the actor's name.
model StockMovement {
  id String @id @default(cuid())
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String
  productName String
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String?
  size Int?
  color String?
  type StockMovementType
  quantity Int
  stockBefore Int
  stockAfter Int
  damagedBefore Int @default(0)
  damagedAfter Int @default(0)
  activeBefore Boolean @default(true)
  activeAfter Boolean @default(true)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?
  actorName String
  // Snapshot only: unpaid orders may be deleted, but their movements must remain.
  orderId String?
  note String @default("")
  requestKey String? @unique
  fingerprint String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
}

enum StockMovementType {
  OPENING
  RECEIPT
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
  RETURN_SELLABLE
  RETURN_DAMAGED
  DAMAGE
  REPAIR
  DISPOSAL
  VARIANT_STATUS
  SHIPMENT
}

model ProductReview {
  id             String       @id @default(cuid())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  rating         Int
  comment        String       @default("")
  status         ReviewStatus @default(PENDING)
  revision       Int          @default(1)
  moderationNote String?
  reviewerId     String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, updatedAt])
}

model PageView {
  id         String   @id
  visitorId  String
  pathname   String
  ipAddress  String?
  userAgent  String?
  referrer   String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([visitorId, pathname, createdAt])
  @@index([productId, createdAt])
}

model Order {
  id                 String          @id @default(cuid())
  user               User            @relation(fields: [userId], references: [id])
  userId             String
  items              OrderItem[]
  invoice            Invoice?
  total              Int
  subtotal           Int?
  productDiscount    Int             @default(0)
  couponDiscount     Int             @default(0)
  coupon             Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId           String?
  couponCode         String?
  couponRedemption   CouponRedemption?
  status             OrderStatus     @default(PENDING)
  recipientName      String?
  checkoutKey        String?         @unique
  checkoutFingerprint String?
  address            String
  phone              String
  postalCode         String?
  trackingCode       String?
  trackingRecordedAt DateTime?
  shippingMethod     ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingMethodId   String?
  shippingMethodName String?
  shippingCost       Int             @default(0)
  // Zarinpal
  authority          String?
  verified           Boolean         @default(false)
  paymentMethod      String?
  paymentStatus      PaymentStatus   @default(UNPAID)
  paymentExpiresAt   DateTime?
  paymentCardNumber  String?
  paymentCardholderName String?
  paymentBankName    String?
  receipts           PaymentReceipt[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([shippingMethodId])
  @@index([phone])
  @@index([postalCode])
  @@index([couponId])
  @@index([paymentMethod, paymentStatus, paymentExpiresAt])
}

model PaymentMethod {
  id             String   @id
  name           String
  description    String?
  isActive       Boolean  @default(false)
  cardNumber     String?
  cardholderName String?
  bankName       String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PaymentReceipt {
  id                String        @id @default(cuid())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId           String
  data              Bytes
  mimeType          String
  payerCardLast4    String?
  transferReference String?
  submissionKey     String
  isLate            Boolean       @default(false)
  status            ReceiptStatus @default(PENDING)
  reviewNote        String?
  reviewerId        String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@unique([orderId, submissionKey])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model ShippingMethod {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String?
  baseCost              Int      @default(0)
  additionalItemCost    Int      @default(0)
  freeShippingThreshold Int?
  isActive              Boolean  @default(false)
  sortOrder             Int      @default(0)
  orders                Order[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  productName String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String?
  quantity  Int
  size      Int
  color     String
  price     Int
  originalPrice Int?
  couponDiscount Int @default(0)

  @@index([variantId])
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  type         CouponType
  value        Int
  maxDiscount  Int?
  minSubtotal  Int        @default(0)
  maxUses      Int?
  perUserLimit Int        @default(1)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean    @default(true)
  // Includes unpaid reservations and paid uses; cancelled/expired uses are released.
  usedCount    Int        @default(0)
  version      Int        @default(1)
  deletedAt    DateTime?
  orders       Order[]
  redemptions  CouponRedemption[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([deletedAt, isActive, createdAt])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  releasedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([couponId, userId, releasedAt])
}

model Invoice {
  id       Int      @id @default(autoincrement())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId  String   @unique
  issuedAt DateTime @default(now())
  snapshot Json
}

// A single store-wide presentation record. The migration constrains id = 1.
model SiteSettings {
  id                    Int      @id @default(1)
  version               Int      @default(1)
  colorTheme            SiteColorTheme @default(forest)
  storeName             String
    showMobileStoreName   Boolean  @default(true)
  tagline               String
  logoUrl               String?
  logoLightUrl          String?
  footerDescription     String   @default("")
  footerCopyright       String   @default("")
  footerLinks           Json     @default("[{\"id\":\"products\",\"label\":\"همهٔ محصولات\",\"href\":\"/products\"},{\"id\":\"about\",\"label\":\"دربارهٔ ما\",\"href\":\"/about\"},{\"id\":\"contact\",\"label\":\"تماس با ما\",\"href\":\"/contact\"},{\"id\":\"tracking\",\"label\":\"پیگیری سفارش\",\"href\":\"/profile\"},{\"id\":\"account\",\"label\":\"حساب کاربری\",\"href\":\"/profile\"},{\"id\":\"cart\",\"label\":\"سبد خرید\",\"href\":\"/cart\"}]")
  footerBadges          Json     @default("[]")
  footerSocialLinks     Json     @default("[]")
  announcementEnabled   Boolean  @default(false)
  announcementText      String   @default("")
  announcementLink      String?
  announcementLinkLabel String   @default("")
  homeHeroProductIds    String[] @default([])
  homeHeroIntervalSeconds Int    @default(10)
  homeBannerEnabled     Boolean  @default(true)
  homeBannerImageUrl    String?
  homeBannerEyebrow     String   @default("از شهر تا مسیرهای تازه")
  homeBannerTitle       String   @default("مسیر بعدی‌ات از اینجا شروع می‌شه.")
  homeBannerDescription String   @default("برای قدم‌های هر روز و ماجراجویی‌های آخر هفته، همراهت رو پیدا کن.")
  homeBannerLink        String?  @default("/products?stock=1")
  homeBannerLinkLabel   String   @default("کشف مدل‌های موجود")
  homeBannerImageAlt    String   @default("کفش طبیعت‌گردی در یک مسیر کوهستانی")
  phone                 String   @default("")
  email                 String   @default("")
  address               String   @default("")
  supportHours          String   @default("")
  instagramUrl          String?
  telegramUrl           String?
  eitaaUrl              String?
  whatsappUrl           String?
  seoTitle              String
  seoDescription        String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum SiteColorTheme {
  forest
  honey
}

enum Role {
  USER
  ADMIN
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShoeType {
  SNEAKER
  FORMAL
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  AWAITING_RECEIPT
  AWAITING_REVIEW
  REJECTED
  PAID
  EXPIRED
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}
